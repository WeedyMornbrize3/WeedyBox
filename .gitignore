# ============================================
# 最小化 .gitignore (Wails v3 + Go)
# ============================================

# 编译产物
*.exe
*.dll
*.so
*.dylib
*.test
*.out
/.task/
/bin/
/dist/

# Go 依赖
/vendor/
go.sum

/build/android/
# build/darwin/ 必须保留：wails3 generate icons 一定会写 mac 图标，
# 目录不存在会让 Windows 构建直接失败（详见 build/Taskfile.yml 的 generate:icons）。
# 故用 .gitkeep 占位，只忽略生成的图标产物。
/build/darwin/*
!/build/darwin/.gitkeep
/build/ios/
/build/linux/
/build/docker/


/node_modules

# 前端构建
/frontend/dist/
/frontend/build/
/frontend/node_modules/
# frontend/package-lock.json 必须纳入版本控制！
# 忽略它会让每次 clone 都重新解析依赖版本，实测曾把 vite 装到 8.3.0，
# 触发 UnoCSS 的 HMR 回归（动态导入的路由页样式不生效）——详见 doc/conventions.md。
/frontend/bindings/
/frontend/.bindings-tmp-1008763502/

# Wails 临时文件
/.wails/
/wails-build/

# 数据库
*.db
*.sqlite
*.sqlite3
*.wal
*.shm

# 环境变量
.env
.env.local
!.env.example

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# 日志
*.log
logs/