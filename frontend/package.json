{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-unocss-tokens.mjs",
    "check:build": "node scripts/check-build-css.mjs"
  },
  "dependencies": {
    "@wailsio/runtime": "latest",
    "pinia": "latest",
    "vue-router": "latest",
    "vue-sonner": "latest"
  },
  "devDependencies": {
    "@iconify/json": "latest",
    "@unocss/preset-attributify": "latest",
    "@unocss/preset-icons": "latest",
    "@unocss/preset-uno": "latest",
    "@vitejs/plugin-vue": "latest",
    "typescript": "latest",
    "unocss": "latest",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
